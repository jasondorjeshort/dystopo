{
  "statusLine": {
    "type": "command",
    "command": "node .claude/statusline.js",
    "refreshInterval": 60
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --list *)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse *)",
      "Bash(git remote -v)",
      "Bash(git stash list)",
      "Bash(git blame *)",
      "Bash(git ls-files *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(node --version)",
      "Bash(python --version)",
      "Bash(gh --version)",
      "Bash(node .claude/hooks/test-hooks.js *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(tools/release.properties)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/usage-gate.js"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/git-guard.js",
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/post-edit.js"
          }
        ]
      }
    ]
  }
}
