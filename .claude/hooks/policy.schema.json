{
  "$comment": "The promised policy schema (ADR 0013; ADR 0025 item 12): per key its type name and base value, as node .claude/hooks/policy.js --schema prints them. Base-owned. Regenerate it in any commit that changes the schema; harness group PS fails a key removed, retyped or with its default changed, and a key not recorded here. Contract: docs/hatchery/decisions/0025-lead-contract.md section 2.",
  "keys": {
    "edit.anchorExempt": {"type":"patterns","default":["docs/design/proposals/*","docs/design/decisions/*","docs/findings/*","docs/hatchery/*"]},
    "edit.capExempt": {"type":"patterns","default":[]},
    "edit.formatters": {"type":"formatters","default":{}},
    "emulators.bootCostGB": {"type":"gigabytes","default":5},
    "emulators.freeFloorGB": {"type":"gigabytes","default":4},
    "emulators.lockDir": {"type":"text","default":"~/.dystopo/emulators"},
    "emulators.max": {"type":"count","default":2},
    "emulators.privateLimitGB": {"type":"gigabytes","default":8},
    "git.branchDelete.branches": {"type":"patterns","default":[]},
    "git.branchDelete.requireMergedPr": {"type":"bool","default":false},
    "git.commit.protectedBranches": {"type":"patterns","default":[]},
    "git.commit.subagents": {"type":"who","default":["runner"]},
    "git.hooksPath": {"type":"pathOrNull","default":null},
    "git.integrate.protectedBranches": {"type":"patternsOrNull","default":null},
    "git.integrate.subagents": {"type":"whoOrNull","default":null},
    "git.push.branches": {"type":"patterns","default":["*"]},
    "git.push.forceWithLease": {"type":"patterns","default":[]},
    "git.push.mainSession": {"type":"bool","default":true},
    "git.push.subagents": {"type":"who","default":["pusher"]},
    "privacy.allow": {"type":"literals","default":["user"]},
    "privacy.identities": {"type":"identities","default":[]},
    "update.exclude": {"type":"patterns","default":[]},
    "usage.deny": {"type":"percentOrNull","default":null},
    "usage.denyAdvice": {"type":"text","default":"Stop all work, run the handoff skill, commit WIP from the main session, end the turn."},
    "usage.finishAgents": {"type":"agents","default":["wave-lead"]},
    "usage.fiveHour.deny": {"type":"percentOrNull","default":null},
    "usage.fiveHour.finish": {"type":"percentOrNull","default":null},
    "usage.fiveHour.hold": {"type":"percentOrNull","default":null},
    "usage.hold": {"type":"percent","default":50},
    "usage.holdAdvice": {"type":"text","default":"Do not start new subagents. Let in-flight agents finish, run the handoff skill, commit from the main session, then report."},
    "usage.overrideEnv": {"type":"envNameOrNull","default":null},
    "usage.pool": {"type":"pool","default":null},
    "usage.sevenDay.deny": {"type":"percentOrNull","default":null},
    "usage.sevenDay.finish": {"type":"percentOrNull","default":null},
    "usage.sevenDay.hold": {"type":"percentOrNull","default":null},
    "usage.staleSeconds": {"type":"seconds","default":7200},
    "usage.whenStale": {"type":"stale","default":"allow"}
  }
}
