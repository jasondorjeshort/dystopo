#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Refuses a push whose outgoing commits carry personal data (ADR 0018); git passes the remote name
# and URL as arguments and the refs on stdin. Enabled per clone: git config core.hooksPath .claude/hooks/git
# git does not show a pre-push hook's stdout (observed with Git for Windows 2.56), so the HIT lines go to stderr.
top=$(git rev-parse --show-toplevel) || exit 2
exec node "$top/.claude/hooks/privacy-scan.js" --pre-push "$1" "$2" >&2
