<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The loopback tile server socket, and (T54) the Share screen: a LAN listener guarded by a 6-digit code and NSD
         (mDNS) announce and discovery, only while that screen is open. NsdManager needs no further permission. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- T31: track recording runs as a location foreground service with a notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- T57: the Share screen's QR scanner (asked for when the scanner opens; the app works without it). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- T83: in-app updates hand a verified APK from GitHub Releases to the system installer (update/UpdateInstaller.kt);
         the user confirms every install and allows installs from Dystopo once. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- T126: spoken turn directions bind the platform text-to-speech engine (package visibility from API 30). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".DystopoApp"
        android:label="@string/app_name"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- T55: dystopo://map?lat=&lon=&z= opens the map there (DeepLink.kt). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dystopo" android:host="map" />
            </intent-filter>
            <!-- T57: dystopo://share?addr=&code= opens the Share screen with both filled in (share/ShareLink.kt). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dystopo" android:host="share" />
            </intent-filter>
        </activity>
        <activity android:name=".about.AboutActivity" android:exported="false" />
        <service
            android:name=".tracking.TrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />
        <!-- T83: the system installer's answers for an update session (only its PendingIntent reaches it). -->
        <receiver android:name=".update.UpdateResultReceiver" android:exported="false" />
    </application>
</manifest>
