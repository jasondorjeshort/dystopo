<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (overrides src/main/res/xml/network_security_config.xml): the release rules plus the
     emulator's host address, for pack downloads and online tiles from devtool serve on the development machine. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
