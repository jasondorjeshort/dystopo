#!/bin/sh
# Chains the Hatchery base's pre-push hook (the personal-data scan of every outgoing commit, its
# ADR 0018) into this project's hooks directory, which core.hooksPath names (owner, 2026-10-17;
# ADR 0037). git passes the remote name and URL as arguments and the refs on stdin; both go through
# untouched. Never bypass with --no-verify: fix the text instead.
top=$(git rev-parse --show-toplevel) || exit 2
exec "$top/.claude/hooks/git/pre-push" "$@"
