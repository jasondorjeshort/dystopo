-- Durable TrackStore schema (T31). One row per track, per recorded point, per waypoint.
-- Coordinates are WGS84 degrees, elevations meters as recorded, times epoch milliseconds UTC
-- (see model/UserData.kt). Points keep their insertion order in `seq` and their segment index in `segment`.
--
-- This file is the CURRENT schema (version 5). Changing it needs a migration: see 1.sqm to 4.sqm and the
-- "Track database migrations" paragraph in CLAUDE.md. New columns go at the END of a table, in the
-- order the migration adds them.
--
-- Version 3 (T44): the tables track, track_point and waypoint are a materialised view of the operation
-- log in sync_op (see sync/Materializer.kt and docs/PLANNING.md > Sync). Every change is first an
-- operation there; the view is updated in the same transaction.

CREATE TABLE track (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    -- 1 while a recorder is appending to it.
    recording INTEGER NOT NULL DEFAULT 0,
    description TEXT,
    comment TEXT,
    source TEXT,
    type TEXT,
    extensions TEXT,
    -- Version 2 (T40): TrackStats cache, computed with the default StatsOptions. stats_points is the
    -- point count it was computed from; NULL means no cache (never computed, or a point was appended since).
    stats_points INTEGER,
    stats_segments INTEGER,
    stats_distance_m REAL,
    stats_ascent_m REAL,
    stats_descent_m REAL,
    stats_min_ele_m REAL,
    stats_max_ele_m REAL,
    stats_start_time INTEGER,
    stats_end_time INTEGER,
    stats_duration_s REAL,
    stats_moving_time_s REAL,
    stats_moving_speed_mps REAL,
    stats_moving_pace_s_per_km REAL,
    stats_overall_pace_s_per_km REAL,
    stats_avg_heart_rate REAL,
    stats_max_heart_rate REAL,
    stats_west REAL,
    stats_south REAL,
    stats_east REAL,
    stats_north REAL
);

CREATE TABLE track_point (
    track_id TEXT NOT NULL,
    seq INTEGER NOT NULL,
    segment INTEGER NOT NULL,
    lat REAL NOT NULL,
    lon REAL NOT NULL,
    ele REAL,
    time INTEGER,
    extensions TEXT,
    PRIMARY KEY (track_id, seq)
);

CREATE TABLE waypoint (
    id TEXT NOT NULL PRIMARY KEY,
    -- The track the waypoint was marked on, or NULL for a free-standing waypoint.
    track_id TEXT,
    seq INTEGER NOT NULL,
    name TEXT NOT NULL,
    lat REAL NOT NULL,
    lon REAL NOT NULL,
    ele REAL,
    time INTEGER,
    description TEXT,
    comment TEXT,
    symbol TEXT,
    type TEXT,
    extensions TEXT,
    -- Version 3 (T44): HLC text of the waypoint's first live put; waypoints of a track are listed in this order.
    created_hlc TEXT
);

CREATE INDEX waypoint_track ON waypoint(track_id, seq);

-- Version 3 (T44): the operation log. One row per operation: its HLC text (unique; sorts in HLC order),
-- the device that made it, the operation type (1 put, 2 set field, 3 append points, 4 delete), the
-- entity kind (1 track, 2 waypoint, 3 route, 4 setting) and id, the parent track of a waypoint or an
-- append, the content digest of an append, and the encoded operation (sync/OpCodec.kt).
CREATE TABLE sync_op (
    hlc TEXT NOT NULL PRIMARY KEY,
    device TEXT NOT NULL,
    type INTEGER NOT NULL,
    kind INTEGER NOT NULL,
    entity TEXT NOT NULL,
    parent TEXT,
    digest TEXT,
    body BLOB NOT NULL
);

CREATE INDEX sync_op_entity ON sync_op(kind, entity, hlc);
CREATE INDEX sync_op_device ON sync_op(device, hlc);
CREATE INDEX sync_op_digest ON sync_op(entity, digest);

-- Version 4 (T60): planned routes, a materialised view of their operations like track. path and
-- waypoints are the encoded field values (model/RoutePlan.kt); created_hlc (the first live put) orders
-- the list; the summary numbers (RouteSummary) are computed when the row is written.
CREATE TABLE route (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    description TEXT,
    comment TEXT,
    type TEXT,
    extensions TEXT,
    path TEXT NOT NULL,
    waypoints TEXT NOT NULL,
    created_hlc TEXT NOT NULL,
    updated_at INTEGER NOT NULL,
    distance_m REAL NOT NULL,
    ascent_m REAL,
    descent_m REAL,
    time_s REAL NOT NULL,
    via_count INTEGER NOT NULL,
    waypoint_count INTEGER NOT NULL,
    straight_m REAL NOT NULL,
    mode TEXT NOT NULL,
    -- Version 5 (T108): the saved turn directions (RouteDirections) when made for this row's path, else NULL.
    directions TEXT
);

CREATE INDEX route_order ON route(created_hlc, id);

-- For every device, the newest of its operations this replica holds (the version vector).
CREATE TABLE sync_vector (
    device TEXT NOT NULL PRIMARY KEY,
    hlc TEXT NOT NULL
);

-- This install's device id (`device`) and whether the log was seeded from version-2 tables (`log`).
CREATE TABLE sync_meta (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

insertTrack:
INSERT INTO track(id, name, created_at, updated_at, recording, description, comment, source, type, extensions)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectTracks:
SELECT t.id, t.name, t.created_at, t.updated_at, t.recording, t.description, t.comment, t.source, t.type, t.extensions,
    (SELECT count(*) FROM track_point p WHERE p.track_id = t.id) AS point_count,
    (SELECT count(*) FROM waypoint w WHERE w.track_id = t.id) AS waypoint_count
FROM track t ORDER BY t.created_at, t.id;

selectTrack:
SELECT t.id, t.name, t.created_at, t.updated_at, t.recording, t.description, t.comment, t.source, t.type, t.extensions,
    (SELECT count(*) FROM track_point p WHERE p.track_id = t.id) AS point_count,
    (SELECT count(*) FROM waypoint w WHERE w.track_id = t.id) AS waypoint_count
FROM track t WHERE t.id = ?;

setRecording:
UPDATE track SET recording = ?, updated_at = ? WHERE id = ?;

touchTrack:
UPDATE track SET updated_at = ? WHERE id = ?;

-- A point was appended: the stats cache is stale.
touchTrackPoints:
UPDATE track SET updated_at = ?, stats_points = NULL WHERE id = ?;

renameTrack:
UPDATE track SET name = ?, updated_at = ? WHERE id = ?;

deleteTrack:
DELETE FROM track WHERE id = ?;

deleteTrackPoints:
DELETE FROM track_point WHERE track_id = ?;

deleteTrackWaypoints:
DELETE FROM waypoint WHERE track_id = ?;

selectStats:
SELECT stats_points, stats_segments, stats_distance_m, stats_ascent_m, stats_descent_m, stats_min_ele_m, stats_max_ele_m,
    stats_start_time, stats_end_time, stats_duration_s, stats_moving_time_s, stats_moving_speed_mps,
    stats_moving_pace_s_per_km, stats_overall_pace_s_per_km, stats_avg_heart_rate, stats_max_heart_rate,
    stats_west, stats_south, stats_east, stats_north
FROM track WHERE id = ?;

putStats:
UPDATE track SET stats_points = ?, stats_segments = ?, stats_distance_m = ?, stats_ascent_m = ?, stats_descent_m = ?,
    stats_min_ele_m = ?, stats_max_ele_m = ?, stats_start_time = ?, stats_end_time = ?, stats_duration_s = ?,
    stats_moving_time_s = ?, stats_moving_speed_mps = ?, stats_moving_pace_s_per_km = ?, stats_overall_pace_s_per_km = ?,
    stats_avg_heart_rate = ?, stats_max_heart_rate = ?, stats_west = ?, stats_south = ?, stats_east = ?, stats_north = ?
WHERE id = ?;

insertPoint:
INSERT INTO track_point(track_id, seq, segment, lat, lon, ele, time, extensions)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

lastPoint:
SELECT seq, segment FROM track_point WHERE track_id = ? ORDER BY seq DESC LIMIT 1;

selectPoints:
SELECT segment, lat, lon, ele, time, extensions FROM track_point WHERE track_id = ? ORDER BY seq;

-- Insert or replace a materialised waypoint, keeping its seq when it exists.
upsertWaypoint:
INSERT OR REPLACE INTO waypoint(id, track_id, seq, name, lat, lon, ele, time, description, comment, symbol, type, extensions, created_hlc)
VALUES (:id, :track_id, coalesce((SELECT seq FROM waypoint WHERE id = :id), (SELECT coalesce(max(seq), -1) + 1 FROM waypoint)),
    :name, :lat, :lon, :ele, :time, :description, :comment, :symbol, :type, :extensions, :created_hlc);

-- Waypoints of a track (or the free-standing ones), in the order they were created.
selectWaypoints:
SELECT * FROM waypoint WHERE track_id = ? ORDER BY created_hlc, seq;

-- A waypoint is visible when it is free-standing or its track exists (a waypoint added concurrently
-- with its track's deletion stays in the table, hidden).
selectWaypoint:
SELECT * FROM waypoint w WHERE w.id = ? AND (w.track_id IS NULL OR EXISTS (SELECT 1 FROM track t WHERE t.id = w.track_id));

selectVisibleWaypoints:
SELECT * FROM waypoint w WHERE w.track_id IS NULL OR EXISTS (SELECT 1 FROM track t WHERE t.id = w.track_id) ORDER BY w.id;

selectAllWaypoints:
SELECT * FROM waypoint ORDER BY seq;

selectWaypointsOfTrack:
SELECT id FROM waypoint WHERE track_id = ?;

setWaypointHlc:
UPDATE waypoint SET created_hlc = ? WHERE id = ?;

deleteWaypoint:
DELETE FROM waypoint WHERE id = ?;

-- Materialised track fields after a merge (T44); updated_at only moves forward.
updateTrackFields:
UPDATE track SET name = ?, created_at = ?, description = ?, comment = ?, source = ?, type = ?, extensions = ?,
    updated_at = max(updated_at, ?) WHERE id = ?;

invalidateStats:
UPDATE track SET stats_points = NULL WHERE id = ?;

selectAllPoints:
SELECT track_id, segment, lat, lon, ele, time, extensions FROM track_point ORDER BY track_id, seq;

-- ---- Operation log (T44) ----

insertOp:
INSERT OR IGNORE INTO sync_op(hlc, device, type, kind, entity, parent, digest, body) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

hasOp:
SELECT count(*) FROM sync_op WHERE hlc = ?;

opsOfEntity:
SELECT body FROM sync_op WHERE kind = ? AND entity = ? ORDER BY hlc;

opsOfKind:
SELECT entity, body FROM sync_op WHERE kind = ? ORDER BY entity, hlc;

tombstoneOf:
SELECT hlc FROM sync_op WHERE kind = ? AND entity = ? AND type = 4 ORDER BY hlc DESC LIMIT 1;

-- Everything on an entity older than its new tombstone.
pruneEntity:
DELETE FROM sync_op WHERE kind = ? AND entity = ? AND hlc < ?;

-- Older appends to the same track with the same content (OpCodec.digest).
sameDigest:
SELECT hlc FROM sync_op WHERE entity = ? AND digest = ? AND hlc < ?;

opsOfDevice:
SELECT body FROM sync_op WHERE device = ? AND hlc > ? ORDER BY hlc;

-- ---- T51: pages, pending counts, run merging, conflicts (queries only; the schema is unchanged) ----

opsOfDeviceLimit:
SELECT body FROM sync_op WHERE device = ? AND hlc > ? ORDER BY hlc LIMIT ?;

countOpsOfDevice:
SELECT count(*) FROM sync_op WHERE device = ? AND hlc > ?;

newestOfEntity:
SELECT hlc FROM sync_op WHERE kind = ? AND entity = ? ORDER BY hlc DESC LIMIT 1;

countDigest:
SELECT count(*) FROM sync_op WHERE entity = ? AND digest = ?;

-- Operations that write fields or delete (no appends), for conflict detection.
fieldOpsOfEntity:
SELECT body FROM sync_op WHERE kind = ? AND entity = ? AND type != 3 ORDER BY hlc;

countOps:
SELECT count(*) FROM sync_op;

lastOp:
SELECT hlc FROM sync_op ORDER BY hlc DESC LIMIT 1;

oldTombstones:
SELECT hlc FROM sync_op WHERE type = 4 AND hlc < ?;

deleteOp:
DELETE FROM sync_op WHERE hlc = ?;

selectVector:
SELECT device, hlc FROM sync_vector ORDER BY device;

putVector:
INSERT OR REPLACE INTO sync_vector(device, hlc) VALUES (?, ?);

getMeta:
SELECT value FROM sync_meta WHERE key = ?;

putMeta:
INSERT OR REPLACE INTO sync_meta(key, value) VALUES (?, ?);

-- ---- Routes (T60) ----

upsertRoute:
INSERT OR REPLACE INTO route(id, name, description, comment, type, extensions, path, waypoints, created_hlc, updated_at,
    distance_m, ascent_m, descent_m, time_s, via_count, waypoint_count, straight_m, mode, directions)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteRouteRow:
DELETE FROM route WHERE id = ?;

selectRoute:
SELECT * FROM route WHERE id = ?;

selectRoutes:
SELECT * FROM route ORDER BY created_hlc, id;

routeIdsInLog:
SELECT DISTINCT entity FROM sync_op WHERE kind = 3;
